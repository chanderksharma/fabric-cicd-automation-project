# Local mirror of the GitHub Environment variables.
#
# Copy to .env and fill in. .env is gitignored; this template is not.
#   cp .env.example .env
#
# Every key is optional. Anything left blank is resolved from the current
# `az login` session, so an empty .env is a working configuration for the ml
# lane. Fill values in to pin them, not because they are required.
#
# None of these are secrets. They are directory and subscription identifiers.
# Authentication is `az login` locally and OIDC federation in CI - there is no
# client secret anywhere in this project, and none belongs in this file.
#
# Load with:
#   pwsh  ->  . ./scripts/Load-Env.ps1
#   bash  ->  source ./scripts/load-env.sh

# Which lane this shell targets: ml (built and run from here) or gh (built and
# run by GitHub Actions). Every resource name carries this suffix, so the two
# lanes coexist in one tenant. Defaults to ml.
FABRIC_LANE=ml

# Entra tenant that owns the subscription and the Fabric tenant.
# Blank resolves to the tenant of the current az session.
AZURE_TENANT_ID=

# Subscription hosting the Fabric capacity and the Terraform state account.
# Blank resolves to the current az session's subscription.
AZURE_SUBSCRIPTION_ID=

# Application (client) ID of sp-fabric-cicd-gh. Used by CI for OIDC login and
# not needed for local runs. The ml lane has no app registration at all.
AZURE_CLIENT_ID=

# Object ID of the sp-fabric-cicd-gh *enterprise application* (service
# principal), not the app registration object ID. Terraform grants this
# principal capacity admin and workspace admin, so a wrong ID here fails
# quietly. Leave blank in the ml lane: you are the administrator.
FABRIC_CICD_SP_OBJECT_ID=

# GUID of the Fabric GitHub source control connection used for Git integration.
# Created by the platform root; read it back with:
#   terraform -chdir=infra/platform output -raw github_connection_id
# Leave blank until the connection exists. Workspaces build without Git
# integration and pick it up on the next apply once this is set.
FABRIC_GITHUB_CONNECTION_ID=
