* text=auto

# Shell scripts must be LF regardless of platform: bash reports the trailing
# carriage return as part of the token and fails with `$'{\r': command not found`.
*.sh text eol=lf

# Windows tooling that expects CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
